        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.accessToken) {",
                  "  pm.environment.set('adminToken', data.accessToken);",
                  "  pm.environment.set('token', data.accessToken);",
                  "}",
                  "if (data.role) {",
                  "  pm.environment.set('activeRole', data.role);",
