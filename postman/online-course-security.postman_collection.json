{
  "info": {
    "_postman_id": "7f0c1c0b-6e46-4f53-a5e1-8d9b3e77c101",
    "name": "Online Course Security",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for the Applied Cryptography project: JWT, bcrypt, AES-GCM, BOLA, HMAC webhook, audit log, and rate limit."
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "student2AccessToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "studentUserId", "value": "1" },
    { "key": "courseId", "value": "1" },
    { "key": "lessonId", "value": "1" },
    { "key": "pendingCourseId", "value": "3" },
    { "key": "pendingEnrollmentId", "value": "3" },
    { "key": "victimCertificateId", "value": "1" },
    { "key": "courseAmount", "value": "299000.00" },
    { "key": "paymentReference", "value": "PAY-POSTMAN-001" },
    { "key": "webhookSecret", "value": "change-me-webhook-secret-with-at-least-32-characters" },
    { "key": "webhookEventId", "value": "" },
    { "key": "webhookTimestamp", "value": "" }
