    {
      "name": "Admin Audit Logs",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/audit-logs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "audit-logs"]
        }
      }
    },
    {
      "name": "Webhook Valid HMAC",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const eventId = `evt_postman_${Date.now()}`;",
              "const timestamp = Math.floor(Date.now() / 1000).toString();",
              "pm.collectionVariables.set('webhookEventId', eventId);",
              "pm.collectionVariables.set('webhookTimestamp', timestamp);",
              "const rawBody = pm.variables.replaceIn(pm.request.body.raw);",
              "const payloadToSign = `${eventId}.${timestamp}.${rawBody}`;",
              "const signature = CryptoJS.HmacSHA256(payloadToSign, pm.collectionVariables.get('webhookSecret')).toString(CryptoJS.enc.Hex);",
              "pm.request.headers.upsert({ key: 'X-Event-Id', value: eventId });",
              "pm.request.headers.upsert({ key: 'X-Timestamp', value: timestamp });",
              "pm.request.headers.upsert({ key: 'X-Signature', value: signature });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enrollmentId\": {{pendingEnrollmentId}},\n  \"userId\": {{studentUserId}},\n  \"courseId\": {{pendingCourseId}},\n  \"paymentReference\": \"{{paymentReference}}\",\n  \"amount\": {{courseAmount}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/payment-success",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks", "payment-success"]
        }
      }
    },
    {
      "name": "Webhook Invalid HMAC",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Event-Id", "value": "evt_invalid_signature" },
          { "key": "X-Timestamp", "value": "1735689600" },
          { "key": "X-Signature", "value": "bad-signature" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enrollmentId\": {{pendingEnrollmentId}},\n  \"userId\": {{studentUserId}},\n  \"courseId\": {{pendingCourseId}},\n  \"paymentReference\": \"PAY-INVALID-001\",\n  \"amount\": {{courseAmount}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/payment-success",
          "host": ["{{baseUrl}}"],
          "path": ["api", "webhooks", "payment-success"]
        }
      }
    },
