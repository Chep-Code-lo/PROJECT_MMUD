            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/courses/{{pendingCourseId}}/checkout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "courses", "{{pendingCourseId}}", "checkout"]
        }
      }
    },
    {
      "name": "Get Lesson With Token",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/courses/{{courseId}}/lessons/{{lessonId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "courses", "{{courseId}}", "lessons", "{{lessonId}}"]
        }
      }
    },
    {
      "name": "Get My Certificate",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (Array.isArray(data) && data.length > 0) {",
              "  pm.collectionVariables.set('victimCertificateId', String(data[0].id));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/certificates/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "certificates", "me"]
        }
      }
    },
    {
      "name": "BOLA Attack Attempt",
      "request": {
