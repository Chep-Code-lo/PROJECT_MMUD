{
  "info": {
    "_postman_id": "7f0c1c0b-6e46-4f53-a5e1-8d9b3e77c101",
    "name": "Online Course Security",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for the Applied Cryptography project: JWT, bcrypt, AES-GCM, enrollment approval, BOLA, audit log, and rate limit."
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "student2AccessToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "studentUserId", "value": "1" },
    { "key": "courseId", "value": "1" },
    { "key": "adminCourseId", "value": "1" },
    { "key": "lessonId", "value": "1" },
    { "key": "pendingCourseId", "value": "3" },
    { "key": "pendingEnrollmentId", "value": "3" },
    { "key": "managedEnrollmentId", "value": "" },
    { "key": "victimCertificateId", "value": "1" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Postman Student\",\n  \"email\": \"postman.student@example.com\",\n  \"password\": \"Password123!\",\n  \"phoneNumber\": \"0909555666\",\n  \"billingAddress\": \"123 Postman Street\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "Login Student 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('accessToken', data.accessToken);",
              "pm.collectionVariables.set('refreshToken', data.refreshToken);",
              "pm.collectionVariables.set('studentUserId', String(data.user.id));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student1@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Login Student 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('student2AccessToken', data.accessToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student2@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('adminAccessToken', data.accessToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Get Courses",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/courses",
          "host": ["{{baseUrl}}"],
          "path": ["api", "courses"]
        }
      }
    },
    {
      "name": "Request Enrollment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('pendingEnrollmentId', String(data.enrollmentId));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/courses/{{pendingCourseId}}/enrollment-requests",
          "host": ["{{baseUrl}}"],
          "path": ["api", "courses", "{{pendingCourseId}}", "enrollment-requests"]
        }
      }
    },
    {
      "name": "Get Lesson With Token",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/courses/{{courseId}}/lessons/{{lessonId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "courses", "{{courseId}}", "lessons", "{{lessonId}}"]
        }
      }
    },
    {
      "name": "Get My Certificate",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (Array.isArray(data) && data.length > 0) {",
              "  pm.collectionVariables.set('victimCertificateId', String(data[0].id));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/certificates/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "certificates", "me"]
        }
      }
    },
    {
      "name": "BOLA Attack Attempt",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{student2AccessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/certificates/{{victimCertificateId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "certificates", "{{victimCertificateId}}"]
        }
      }
    },
    {
      "name": "Admin Get Courses",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/courses",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "courses"]
        }
      }
    },
    {
      "name": "Admin Get Course Roster",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/courses/{{pendingCourseId}}/enrollments",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "courses", "{{pendingCourseId}}", "enrollments"]
        }
      }
    },
    {
      "name": "Admin Approve Pending Enrollment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/enrollments/{{pendingEnrollmentId}}/approve",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "enrollments", "{{pendingEnrollmentId}}", "approve"]
        }
      }
    },
    {
      "name": "Admin Add Student To Course",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('managedEnrollmentId', String(data.enrollmentId));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student2@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/courses/{{pendingCourseId}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "courses", "{{pendingCourseId}}", "students"]
        }
      }
    },
    {
      "name": "Admin Get Student Profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/users/{{studentUserId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "users", "{{studentUserId}}"]
        }
      }
    },
    {
      "name": "Admin Remove Enrollment",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/enrollments/{{managedEnrollmentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "enrollments", "{{managedEnrollmentId}}"]
        }
      }
    },
    {
      "name": "Admin Audit Logs",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/audit-logs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "audit-logs"]
        }
      }
    },
    {
      "name": "Rate Limit Test - Wrong Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student1@example.com\",\n  \"password\": \"WrongPassword123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    }
  ]
}
