    {
      "name": "Checkout Course",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('pendingEnrollmentId', String(data.enrollmentId));",
              "pm.collectionVariables.set('paymentReference', data.paymentReference);"
